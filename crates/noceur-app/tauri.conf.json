{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Noceur",
  "version": "0.1.0",
  "identifier": "app.noceur.desktop",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "Noceur",
        "width": 1320,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "mtsbh",
    "category": "Music",
    "shortDescription": "An audio-aware file browser for DJs.",
    "longDescription": "A file browser that shows BPM, key and duration per row, plays and scrubs, tags, and tells you whether a file is really what it claims to be.",
    "licenseFile": "../../LICENSE",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
